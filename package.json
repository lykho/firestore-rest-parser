{
  "name": "firestore-rest-parser",
  "version": "2.0.0",
  "description": "Parse and use Firestore REST API JSON as a pure js object",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "firestore",
    "firebase",
    "firebase-admin",
    "parser",
    "converter"
  ],
  "author": {
    "name": "Kirill Lykho",
    "email": "lykho.kirill@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lykho/firestore-rest-parser"
  },
  "homepage": "https://github.com/lykho/firestore-rest-parser#readme",
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.16.0",
    "husky": "^9.1.7",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "prettier": {
    "printWidth": 80,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
